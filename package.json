{
  "name": "bstack",
  "version": "0.2.0",
  "private": true,
  "description": "bStack: Minimal, opinionated skills for AI agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xr3ngar/bstack.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@changesets/cli": "2",
    "@types/bun": "1.3.11",
    "skills": "1.7.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun scripts/validate-skills.ts",
    "check": "bun run typecheck && bun run validate && bun test",
    "check:install": "bun scripts/check-installation.ts",
    "changeset": "bun --bun node_modules/@changesets/cli/bin.js",
    "version:skills": "bun run changeset version && bun install --lockfile-only",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
